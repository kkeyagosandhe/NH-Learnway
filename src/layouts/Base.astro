---
import '../styles/global.css';

interface Props {
  title?: string;
  total?: number; // concepts on the trail, for the progress meter
}
const { title = 'NH-Learnway', total = 18 } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Karla:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-total={total}>
    <header class="bar-wrap">
      <div class="bar">
        <a class="brand" href="/">
          <h1>NH-LEARNWAY</h1>
          <p>the concepts, one at a time · at your own pace</p>
        </a>
        <div class="meter">
          <div class="meter-top">
            <span class="rank" id="rank">Just beginning</span>
            <span class="count" id="count">0 / {total} learned</span>
          </div>
          <div class="track"><div class="fill" id="fill"></div></div>
        </div>
        <div class="actions">
          <a class="chip" href="/how-to-use">How to use</a>
          <button class="chip" id="resetBtn" type="button">Reset</button>
        </div>
      </div>
    </header>

    <slot />

    <canvas id="confetti"></canvas>

    <script>
      import { loadDone, reset } from '../scripts/progress';

      const total = Number(document.body.dataset.total || '18');
      const fill = document.getElementById('fill');
      const count = document.getElementById('count');
      const rank = document.getElementById('rank');

      function rankFor(p: number): string {
        if (p <= 0) return 'Just beginning';
        if (p < 20) return 'Finding your feet';
        if (p < 45) return 'Building real understanding';
        if (p < 70) return "It's clicking";
        if (p < 100) return 'Nearly fluent';
        return 'Fundamentals solid';
      }

      function refresh(): void {
        const c = loadDone().length;
        const p = Math.round((c / total) * 100);
        if (fill) fill.style.width = p + '%';
        if (count) count.textContent = c + ' / ' + total + ' learned';
        if (rank) rank.textContent = rankFor(p);
      }

      document.getElementById('resetBtn')?.addEventListener('click', () => {
        if (window.confirm('Reset all progress? This cannot be undone.')) {
          reset();
          window.dispatchEvent(new CustomEvent('progress-changed'));
        }
      });

      refresh();
      window.addEventListener('progress-changed', refresh);
      window.addEventListener('storage', refresh);
    </script>
  </body>
</html>
