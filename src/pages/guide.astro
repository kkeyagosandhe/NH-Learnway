---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const total = (await getCollection('milestones')).length;

const groups = [
  {
    title: 'Interview DSA',
    items: [
      ['NeetCode roadmap', 'https://neetcode.io/roadmap', 'free'],
      ['NeetCode 150 list', 'https://neetcode.io/practice', 'free'],
      ['Striver A2Z sheet', 'https://takeuforward.org/strivers-a2z-dsa-course/strivers-a2z-dsa-course-sheet-2', 'free'],
      ['Grind 75', 'https://www.techinterviewhandbook.org/grind75', 'free'],
      ['LeetCode', 'https://leetcode.com', 'free tier'],
    ],
  },
  {
    title: 'Competitive programming',
    items: [
      ['Codeforces', 'https://codeforces.com', 'free'],
      ['AtCoder Beginner Contests', 'https://atcoder.jp/contests/', 'free'],
      ['CSES Problem Set', 'https://cses.fi/problemset', 'free'],
      ['CP-31 sheet', 'https://www.tle-eliminators.com/cp-sheet', 'free'],
      ['CP Handbook (PDF)', 'https://cses.fi/book/book.pdf', 'free'],
    ],
  },
  {
    title: 'Build real things',
    items: [
      ['CodeCrafters', 'https://codecrafters.io', 'free challenges'],
      ['build-your-own-x', 'https://github.com/codecrafters-io/build-your-own-x', 'free'],
      ['project-based-learning', 'https://github.com/practical-tutorials/project-based-learning', 'free'],
    ],
  },
  {
    title: 'Foundations & clean code',
    items: [
      ['The Odin Project', 'https://www.theodinproject.com', 'free'],
      ['Teach Yourself CS', 'https://teachyourselfcs.com', 'free'],
      ['roadmap.sh', 'https://roadmap.sh', 'free'],
      ['Harvard CS50', 'https://cs50.harvard.edu', 'free'],
    ],
  },
  {
    title: 'AI / ML engineering',
    items: [
      ['LLMs from scratch', 'https://github.com/rasbt/LLMs-from-scratch', 'free'],
      ['LLM course', 'https://github.com/mlabonne/llm-course', 'free'],
      ['Prompt Engineering Guide', 'https://www.promptingguide.ai', 'free'],
      ['RAG Techniques', 'https://github.com/NirDiamant/RAG_Techniques', 'free'],
      ['DeepLearning.AI courses', 'https://www.deeplearning.ai/courses', 'mostly free'],
    ],
  },
  {
    title: 'Consistency',
    items: [
      ['Focusmate', 'https://www.focusmate.com', '3/week free'],
      ['Habitica', 'https://habitica.com', 'free'],
      ['Never miss twice', 'https://jamesclear.com/habit-tracker', 'free'],
    ],
  },
];
---

<Base title="Field guide · NH-Learnway" total={total}>
  <main>
    <a href="/" class="back">← The trail</a>
    <div class="eyebrow">Everything is free</div>
    <h1>Field guide</h1>

    <p class="note">
      Every resource on this map is free to use. A few have optional paid tiers you can safely
      ignore: <b>NeetCode</b> (free lists + free YouTube videos cover everything; the polished
      on-site courses are paid), <b>CodeCrafters</b> (free challenges, no card; the full catalog
      is paid), <b>Focusmate</b> (free up to 3 sessions a week), and <b>Habitica</b> (free; only
      cosmetics cost money). Skip anything sold as a shortcut.
    </p>

    {
      groups.map((g) => (
        <section class="group">
          <h3>{g.title}</h3>
          <ul>
            {g.items.map(([label, url, tag]) => (
              <li>
                <a href={url} target="_blank" rel="noopener">
                  <span>{label}</span>
                  <small>{tag}</small>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="group">
      <h3>The three rules</h3>
      <div class="rules">
        <p><b>One tiny rep a day.</b> Open the editor, do one small thing. Showing up is the win.</p>
        <p><b>One active project.</b> Finish it, or a stage of it, before starting anything new.</p>
        <p><b>Never miss twice.</b> A missed day is an accident. Two in a row starts a new habit.</p>
      </div>
    </section>
  </main>

  <style>
    main { position: relative; z-index: 1; max-width: 620px; margin: 0 auto; padding: 28px 18px 100px; }
    .back { text-decoration: none; color: var(--ink-soft); font-weight: 700; font-size: 14px; }
    .back:hover { color: var(--ink); }
    .eyebrow {
      margin-top: 18px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.06em;
      color: var(--mint);
      text-transform: uppercase;
    }
    h1 { font-family: var(--display); font-weight: 600; font-size: 28px; margin: 4px 0 18px; }
    .note {
      font-size: 13.5px;
      line-height: 1.55;
      color: var(--ink-soft);
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 14px 16px;
    }
    .note b { color: var(--ink); }
    .group h3 { font-family: var(--display); font-weight: 600; font-size: 16px; margin: 26px 0 10px; color: var(--mint); }
    .group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
    .group li a {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      text-decoration: none;
      color: var(--ink);
      font-weight: 700;
      font-size: 14px;
      padding: 10px 13px;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.07);
      transition: 0.15s;
    }
    .group li a:hover { background: rgba(255, 255, 255, 0.1); }
    .group li a small { color: var(--ink-faint); font-weight: 700; }
    .rules { font-size: 14.5px; line-height: 1.6; color: var(--ink-soft); }
    .rules p { margin: 0 0 10px; }
    .rules b { color: var(--mint); }
  </style>
</Base>
