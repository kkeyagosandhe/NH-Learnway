---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { CHAPTERS, CHAPTER_RANK } from '../data/chapters';

const concepts = (await getCollection('concepts')).sort(
  (a, b) =>
    CHAPTER_RANK[a.data.chapter] - CHAPTER_RANK[b.data.chapter] ||
    a.data.order - b.data.order,
);
const total = concepts.length;
---

<Base title="NH-Learnway" total={total}>
  <main>
    <p class="lede">
      <b>{total} concepts</b>, in learning order — a road from your first line of code to
      interview-ready. Drive up to a sign, learn the concept, mark it done, and the car
      rolls on. No apps, no timers. <b>One stop at a time.</b>
    </p>

    <div id="trail">
      <svg id="road" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="litGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#F2C6A9" />
            <stop offset="0.33" stop-color="#F4B8CB" />
            <stop offset="0.66" stop-color="#C7B9EC" />
            <stop offset="1" stop-color="#A9D9C6" />
          </linearGradient>
        </defs>
        <path id="roadEdge" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
        <path id="roadFill" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
        <path id="roadLine" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
        <path id="roadLit" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>

      {
        concepts.map((m, i) => {
          const ch = CHAPTERS[m.data.chapter];
          const isChapterStart = i === 0 || concepts[i - 1].data.chapter !== m.data.chapter;
          return (
            <a
              class="sign"
              href={`/path/${m.id}`}
              data-i={i}
              data-slug={m.id}
              aria-label={m.data.title}
              style={`--hue:${ch.hue};--chip:${ch.chip};--chipink:${ch.ink}`}
            >
              {isChapterStart && <span class="chap">{ch.n} · {ch.name}</span>}
              <span class="board">
                <span class="num">{i + 1}</span>
                <span class="nm">{m.data.title}</span>
              </span>
              <span class="post"></span>
            </a>
          );
        })
      }

      <div id="car" aria-hidden="true">
        <svg viewBox="0 0 50 26" class="car-svg">
          <path
            class="car-body"
            d="M2 17 Q2 12 8 11 L15 6 Q17 5 21 5 L33 5 Q37 5 40 9 L45 12 Q48 13 48 17 L48 19 Q48 21 46 21 L4 21 Q2 21 2 19 Z"
          />
          <path class="car-glass" d="M17 8 L20 8 L20 11 L14 11 Z M23 8 L33 8 Q35 8 37 11 L23 11 Z" />
          <circle class="wheel" cx="15" cy="21" r="4" />
          <circle class="wheel" cx="38" cy="21" r="4" />
        </svg>
      </div>
    </div>
  </main>

  <script>
    import { loadDone } from '../scripts/progress';

    const trail = document.getElementById('trail')!;
    const svg = document.getElementById('road') as unknown as SVGSVGElement;
    const roadEdge = document.getElementById('roadEdge') as unknown as SVGPathElement;
    const roadFill = document.getElementById('roadFill') as unknown as SVGPathElement;
    const roadLine = document.getElementById('roadLine') as unknown as SVGPathElement;
    const roadLit = document.getElementById('roadLit') as unknown as SVGPathElement;
    const car = document.getElementById('car')!;
    const signs = Array.from(trail.querySelectorAll<HTMLAnchorElement>('.sign'));
    const slugs = signs.map((s) => s.dataset.slug!);
    const N = signs.length;
    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    type Pos = { x: number; y: number; dir: 1 | -1 };
    let pos: Pos[] = [];

    function perRow(w: number): number {
      if (w >= 780) return 4;
      if (w >= 520) return 3;
      return 2;
    }

    function layout(): void {
      const W = trail.clientWidth;
      const cols = perRow(W);
      const rowGap = W < 520 ? 150 : 168;
      const R = rowGap / 2; // hairpin radius
      const padTop = 128; // room for signs (which sit above the road) + chapter label
      const sidePad = 26;
      const xL = R + sidePad;
      const xR = W - R - sidePad;
      const step = cols > 1 ? (xR - xL) / (cols - 1) : 0;
      const rows = Math.ceil(N / cols);
      const Y = (r: number) => padTop + r * rowGap;

      pos = [];
      for (let i = 0; i < N; i++) {
        const r = Math.floor(i / cols);
        const k = i % cols;
        const goingRight = r % 2 === 0;
        const col = goingRight ? k : cols - 1 - k;
        pos.push({ x: xL + col * step, y: Y(r), dir: goingRight ? 1 : -1 });
      }

      // position the signs
      signs.forEach((s, i) => {
        s.style.left = pos[i].x + 'px';
        s.style.top = pos[i].y + 'px';
      });

      // build the serpentine road path
      let d = `M ${xL.toFixed(1)} ${Y(0).toFixed(1)}`;
      for (let r = 0; r < rows; r++) {
        const yy = Y(r);
        const goingRight = r % 2 === 0;
        const fullEndX = goingRight ? xR : xL;
        const isLast = r === rows - 1;
        // trim the final row to the last sign
        const endX = isLast ? pos[N - 1].x : fullEndX;
        d += ` L ${endX.toFixed(1)} ${yy.toFixed(1)}`;
        if (!isLast) {
          const yn = Y(r + 1);
          const sweep = goingRight ? 1 : 0;
          d += ` A ${R.toFixed(1)} ${R.toFixed(1)} 0 0 ${sweep} ${fullEndX.toFixed(1)} ${yn.toFixed(1)}`;
        }
      }

      const H = Y(rows - 1) + 70;
      trail.style.height = H + 'px';
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.setAttribute('width', String(W));
      svg.setAttribute('height', String(H));
      [roadEdge, roadFill, roadLine, roadLit].forEach((p) => p.setAttribute('d', d));

      applyProgress(false);
    }

    function nearestLen(pt: { x: number; y: number }): number {
      const total = roadEdge.getTotalLength ? roadEdge.getTotalLength() : 0;
      if (!total) return 0;
      let best = 0;
      let bestD = Infinity;
      const steps = 260;
      for (let s = 0; s <= steps; s++) {
        const l = (total * s) / steps;
        const p = roadEdge.getPointAtLength(l);
        const dx = p.x - pt.x;
        const dy = p.y - pt.y;
        const dd = dx * dx + dy * dy;
        if (dd < bestD) {
          bestD = dd;
          best = l;
        }
      }
      return best;
    }

    // --- the car drives ALONG the road path (getPointAtLength), not in a straight line ---
    let carLen = 0; // the car's position measured as a length along the road
    let lastFace = 1; // 1 = facing right, -1 = facing left
    let raf = 0;
    const SEEN_KEY = 'nhlearnway_carseen_v2';

    function pathLen(): number {
      return roadLit.getTotalLength ? roadLit.getTotalLength() : 0;
    }

    // put the car (and the lit road) at a given length along the path
    function place(len: number): void {
      const total = pathLen();
      const L = Math.max(0, Math.min(len, total));
      carLen = L;
      const p = roadLit.getPointAtLength(L);
      const ahead = roadLit.getPointAtLength(Math.min(L + 3, total));
      const dx = ahead.x - p.x;
      if (dx > 0.05) lastFace = 1;
      else if (dx < -0.05) lastFace = -1;
      car.style.transform = `translate(${p.x}px, ${p.y}px) translate(-50%, -50%) scaleX(${lastFace})`;
      roadLit.style.strokeDasharray = String(total);
      roadLit.style.strokeDashoffset = String(total - L);
    }

    // The frontier: the furthest sign you have finished (where the car parks), and the
    // next sign to glow. Nothing finished yet -> the car waits at the very first sign.
    function frontier(): { car: number; next: number } {
      const done = loadDone();
      let furthest = -1;
      for (let i = 0; i < N; i++) if (done.indexOf(slugs[i]) !== -1 && i > furthest) furthest = i;
      const car = furthest < 0 ? 0 : furthest;
      const next = furthest < 0 ? 0 : Math.min(furthest + 1, N - 1);
      return { car, next };
    }

    function lenForIndex(i: number): number {
      if (i <= 0 && loadDone().length === 0) return 0;
      return nearestLen(pos[i]);
    }

    function refreshStates(): void {
      const done = loadDone();
      const next = frontier().next;
      signs.forEach((s, i) => {
        const isDone = done.indexOf(slugs[i]) !== -1;
        s.classList.toggle('done', isDone);
        s.classList.toggle('next', i === next && !isDone);
      });
    }

    // animate the car forward along the road to a target length
    function driveTo(target: number): void {
      const start = carLen;
      const dist = Math.abs(target - start);
      cancelAnimationFrame(raf);
      if (reduce || dist < 1) {
        place(target);
        return;
      }
      const dur = Math.max(700, Math.min(2000, dist * 1.15));
      const t0 = performance.now();
      const ease = (u: number) => (u < 0.5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2);
      const tick = (now: number) => {
        const u = Math.min(1, (now - t0) / dur);
        place(start + (target - start) * ease(u));
        if (u < 1) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    }

    // reflect current progress; animate the drive only when asked
    function applyProgress(animate: boolean): void {
      refreshStates();
      const target = lenForIndex(frontier().car);
      if (animate) driveTo(target);
      else place(target);
    }

    function saveSeen(): void {
      try { window.localStorage.setItem(SEEN_KEY, String(frontier().car)); } catch (e) {}
    }

    // Reflect current progress, driving the car FROM the last-seen sign (or the very
    // start on a first visit) TO the current one — so returning after learning a
    // concept actually shows the car move.
    function catchUp(): void {
      const carIndex = frontier().car;
      refreshStates();
      let seen: number | null = null;
      try {
        const raw = window.localStorage.getItem(SEEN_KEY);
        if (raw !== null) { const n = parseInt(raw, 10); if (!isNaN(n)) seen = n; }
      } catch (e) {}
      const from = seen === null ? 0 : seen; // first visit: drive up from the start
      if (!reduce && from < carIndex) {
        place(lenForIndex(from));
        driveTo(lenForIndex(carIndex));
      } else {
        place(lenForIndex(carIndex));
      }
      saveSeen();
    }

    function boot(): void {
      layout(); // build the road + position the signs
      catchUp(); // then place or drive the car
    }

    let rt: number | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(layout, 120); // re-place instantly on resize, no drive
    });
    window.addEventListener('progress-changed', () => { applyProgress(true); saveSeen(); });
    window.addEventListener('storage', () => { applyProgress(true); saveSeen(); });
    // the browser Back button can restore from bfcache without re-running the script,
    // so re-run the catch-up drive when the page is shown from cache.
    window.addEventListener('pageshow', (e) => {
      if ((e as PageTransitionEvent).persisted) boot();
    });

    // one startup, once — the double-boot was what cancelled the drive
    requestAnimationFrame(boot);
  </script>

  <style>
    main { position: relative; z-index: 1; max-width: 860px; margin: 0 auto; padding: 34px 16px 120px; }
    .lede { text-align: center; margin: 6px auto 26px; max-width: 560px; color: var(--ink-soft); font-size: 15px; line-height: 1.55; }
    .lede b { color: var(--ink); font-weight: 700; }

    #trail { position: relative; width: 100%; }
    #road { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
    /* hollow, outlined road (two edges), then a faint centre line, then the lit stretch */
    #roadEdge { stroke: rgba(190, 178, 196, 0.16); stroke-width: 26; }
    #roadFill { stroke: var(--night); stroke-width: 22; }
    #roadLine { stroke: rgba(190, 178, 196, 0.18); stroke-width: 2; stroke-dasharray: 1 15; }
    #roadLit { stroke: url(#litGrad); stroke-width: 3.5; opacity: 0.9; }

    .sign { position: absolute; z-index: 2; text-decoration: none; transform: translate(-50%, -100%); display: flex; flex-direction: column; align-items: center; width: 150px; }
    .chap { position: absolute; top: -22px; white-space: nowrap; font-family: var(--display); font-weight: 600; font-size: 12.5px; color: var(--ink-faint); }
    .board {
      position: relative;
      width: 100%;
      min-height: 52px;
      border-radius: 13px;
      border: 1.5px solid rgba(190, 178, 196, 0.28);
      background: rgba(31, 25, 38, 0.6);
      backdrop-filter: blur(2px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      padding: 9px 10px;
      transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.25s, background 0.25s, box-shadow 0.25s;
    }
    .board .num { font-family: var(--display); font-weight: 600; font-size: 11px; color: var(--ink-faint); }
    .board .nm { font-family: var(--display); font-weight: 500; font-size: 13.5px; line-height: 1.15; color: var(--ink-soft); text-align: center; }
    .post { width: 2px; height: 30px; background: rgba(190, 178, 196, 0.22); }

    .sign:hover .board { transform: translateY(-3px); border-color: var(--hue); }
    .sign:focus-visible .board { outline: 3px solid var(--ink); outline-offset: 3px; }

    .sign.next .board { border-color: var(--hue); background: rgba(31, 25, 38, 0.9); box-shadow: 0 0 0 4px color-mix(in srgb, var(--hue) 18%, transparent), 0 10px 26px -10px var(--hue); }
    .sign.next .board .nm { color: var(--ink); }
    .sign.next .post { background: var(--hue); }

    .sign.done .board { border-color: transparent; background: var(--chip); box-shadow: 0 8px 22px -10px var(--chip); }
    .sign.done .board .num { color: color-mix(in srgb, var(--chipink) 70%, transparent); }
    .sign.done .board .nm { color: var(--chipink); }
    .sign.done .post { background: var(--chip); }
    .sign.done .board::after { content: '✓'; position: absolute; top: 4px; right: 8px; font-size: 12px; font-weight: 800; color: var(--chipink); }

    #car { position: absolute; left: 0; top: 0; z-index: 3; width: 50px; height: 26px; pointer-events: none; }
    .car-svg { width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.45)); }
    .car-body { fill: #f4b8cb; }
    .car-glass { fill: #17131b; opacity: 0.7; }
    .wheel { fill: #2c2028; stroke: #f4b8cb; stroke-width: 1.5; }

    @media (prefers-reduced-motion: reduce) {
      #car, .board { transition: none; }
    }
    @media (max-width: 520px) {
      .sign { width: 118px; }
      .board .nm { font-size: 12px; }
      .chap { font-size: 11px; }
    }
  </style>
</Base>
