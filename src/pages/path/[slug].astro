---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HashViz from '../../components/HashViz.astro';
import { CHAPTERS, CHAPTER_RANK } from '../../data/chapters';

export async function getStaticPaths() {
  const all = (await getCollection('concepts')).sort(
    (a, b) =>
      CHAPTER_RANK[a.data.chapter] - CHAPTER_RANK[b.data.chapter] ||
      a.data.order - b.data.order,
  );
  return all.map((m, i) => ({
    params: { slug: m.id },
    props: {
      m,
      index: i,
      total: all.length,
      prev: i > 0 ? { slug: all[i - 1].id, title: all[i - 1].data.title } : null,
      next: i < all.length - 1 ? { slug: all[i + 1].id, title: all[i + 1].data.title } : null,
    },
  }));
}

interface Props {
  m: CollectionEntry<'concepts'>;
  index: number;
  total: number;
  prev: { slug: string; title: string } | null;
  next: { slug: string; title: string } | null;
}

const { m, index, total, prev, next } = Astro.props;
const d = m.data;
const ch = CHAPTERS[d.chapter];
---

<Base title={`${d.title} · NH-Learnway`} total={total}>
  <main style={`--hue:${ch.hue}`}>
    <nav class="crumbs">
      <a href="/" class="back">← All concepts</a>
      <span class="pos">{index + 1} / {total}</span>
    </nav>

    <header class="hero">
      <div class="eyebrow" style={`color:${ch.hue}`}>
        <span class="badge" style={`background:${ch.hue};color:${ch.ink}`}>{index + 1}</span>
        {ch.name} · {ch.tag}
      </div>
      <h1>{d.title}</h1>
    </header>

    {
      d.gist && (
        <div class="gist">
          <span class="gist-lab">In plain words</span>
          <p>{d.gist}</p>
        </div>
      )
    }

    <section class="sec">
      <h3><span class="dot"></span>The picture</h3>
      <ul class="bul">{d.picture.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section class="sec">
      <h3><span class="dot"></span>Where it comes from</h3>
      <ul class="bul">{d.origin.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section class="sec">
      <h3><span class="dot"></span>What you're going for</h3>
      <ul class="bul">{d.purpose.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section class="sec">
      <h3><span class="dot"></span>The click</h3>
      <ul class="bul">{d.click.map((x) => <li>{x}</li>)}</ul>
    </section>

    {
      d.cues.length > 0 && (
        <section class="sec">
          <h3><span class="dot"></span>Recognition cues</h3>
          <p class="lead">Reach for it when the problem says things like:</p>
          <div class="cues">{d.cues.map((c) => <span>{c}</span>)}</div>
        </section>
      )
    }

    {
      d.why && (
        <section class="sec">
          <h3><span class="dot"></span>Why interviewers ask this</h3>
          <div class="whybox">{d.why}</div>
        </section>
      )
    }

    {
      (d.good?.length || d.bad?.length) && (
        <section class="sec">
          <h3><span class="dot"></span>Good at, and not</h3>
          <div class="twocol">
            {d.good && d.good.length > 0 && (
              <div class="mini good">
                <h4>Strong at</h4>
                <ul class="bul">{d.good.map((x) => <li>{x}</li>)}</ul>
              </div>
            )}
            {d.bad && d.bad.length > 0 && (
              <div class="mini bad">
                <h4>Watch out</h4>
                <ul class="bul">{d.bad.map((x) => <li>{x}</li>)}</ul>
              </div>
            )}
          </div>
        </section>
      )
    }

    {
      d.prereqs && d.prereqs.length > 0 && (
        <section class="sec">
          <h3><span class="dot"></span>Before this clicks</h3>
          <p class="lead">Be comfortable with:</p>
          <ul class="bul tick">{d.prereqs.map((x) => <li>{x}</li>)}</ul>
        </section>
      )
    }

    {
      d.toolkit && d.toolkit.length > 0 && (
        <section class="sec">
          <h3><span class="dot"></span>The toolkit — what each piece does</h3>
          <dl class="toolkit">
            {d.toolkit.map((t) => (
              <div class="tk-row">
                <dt><code>{t.code}</code></dt>
                <dd>{t.does}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {d.viz === 'hashmap' && (
      <section class="sec">
        <h3><span class="dot"></span>See it happen</h3>
        <HashViz />
      </section>
    )}

    {
      d.solve && (
        <section class="sec">
          <h3><span class="dot"></span>How to solve it</h3>
          <p class="lead">{d.solve.lead}</p>
          <ol class="steps">
            {d.solve.steps.map((s) => (
              <li><span class="do">{s.do}</span>{s.why}</li>
            ))}
          </ol>
          {d.solve.keep && (
            <div class="keepbox"><div class="klab">Keep this true</div>{d.solve.keep}</div>
          )}
        </section>
      )
    }

    {
      d.code && (
        <section class="sec">
          <h3><span class="dot"></span>The worked solution</h3>
          <div class="reveal-code">
            <button type="button" class="reveal-btn" id="codeBtn">Show the worked code</button>
            <pre class="code" id="codeBlock" hidden><code>{d.code}</code></pre>
          </div>
        </section>
      )
    }

    <section class="sec">
      <h3><span class="dot"></span>Build it (tiny)</h3>
      <div class="qcard">
        <p>{d.build.blurb}</p>
        <div class="qlab">You'll practice</div>
        <div class="qskills">{d.build.skills.map((s) => <span>{s}</span>)}</div>
        <div class="qout">Outcome: {d.build.out}</div>
      </div>
    </section>

    {
      d.ai && d.ai.length > 0 && (
        <section class="sec">
          <h3><span class="dot"></span>Using AI well</h3>
          <ul class="bul">{d.ai.map((x) => <li>{x}</li>)}</ul>
        </section>
      )
    }

    {
      d.practice && d.practice.length > 0 && (
        <section class="sec">
          <h3><span class="dot"></span>Two problems</h3>
          <p class="lead">Only after it clicks. Both free on LeetCode.</p>
          <div class="chiplinks">
            {d.practice.map((p) => (
              <a href={p.url} target="_blank" rel="noopener">{p.label}<span class="free">free</span></a>
            ))}
          </div>
        </section>
      )
    }

    {
      d.complexity && d.complexity.length > 0 && (
        <section class="sec">
          <h3><span class="dot"></span>Complexity</h3>
          <div class="cxcard">
            <table class="cxtable">
              {d.complexity.map((r) => (
                <tr>
                  <td class="cxop">{r.op}</td>
                  <td class="cxval"><b>{r.val}</b>{r.note && <span class="cxnote">{r.note}</span>}</td>
                </tr>
              ))}
            </table>
            {d.complexityNote && <p class="cxfoot">{d.complexityNote}</p>}
          </div>
        </section>
      )
    }

    <nav class="pager">
      {prev ? <a href={`/path/${prev.slug}`} class="pg prev"><span>← Previous</span><b>{prev.title}</b></a> : <span></span>}
      {next ? <a href={`/path/${next.slug}`} class="pg next"><span>Next →</span><b>{next.title}</b></a> : <span></span>}
    </nav>
  </main>

  <div class="lit-bar" style={`--hue:${ch.hue}`}>
    <button type="button" id="litToggle" data-slug={m.id} data-chip={ch.chip}></button>
  </div>

  <script>
    import { isDone, toggle } from '../../scripts/progress';
    import { burst } from '../../scripts/confetti';

    const codeBtn = document.getElementById('codeBtn');
    codeBtn?.addEventListener('click', () => {
      document.getElementById('codeBlock')?.removeAttribute('hidden');
      codeBtn.style.display = 'none';
    });

    const btn = document.getElementById('litToggle') as HTMLButtonElement | null;
    if (btn) {
      const slug = btn.dataset.slug!;
      const chip = btn.dataset.chip || '#fff';
      const paint = () => {
        const done = isDone(slug);
        btn.textContent = done ? 'Learned ✓ — mark as not learned' : 'Mark as learned';
        btn.classList.toggle('undo', done);
      };
      paint();
      btn.addEventListener('click', () => {
        const nowDone = toggle(slug);
        paint();
        window.dispatchEvent(new CustomEvent('progress-changed'));
        if (nowDone) {
          const r = btn.getBoundingClientRect();
          burst(r.left + r.width / 2, r.top + r.height / 2, chip);
        }
      });
    }
  </script>

  <style>
    main { position: relative; z-index: 1; max-width: 680px; margin: 0 auto; padding: 26px 18px 140px; }
    .crumbs { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
    .back { text-decoration: none; color: var(--ink-soft); font-weight: 700; font-size: 14px; }
    .back:hover { color: var(--ink); }
    .pos { font-size: 12px; color: var(--ink-faint); font-weight: 700; font-variant-numeric: tabular-nums; }

    .hero { margin-bottom: 6px; }
    .eyebrow { display: flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; }
    .badge { width: 30px; height: 30px; border-radius: 10px; display: grid; place-items: center; font-family: var(--display); font-weight: 600; font-size: 15px; }
    h1 { font-family: var(--display); font-weight: 600; font-size: 32px; line-height: 1.1; margin: 13px 0 4px; color: var(--ink); }

    .gist { margin: 16px 0 4px; padding: 14px 16px; background: var(--night-2); border: 1px solid var(--line-dim); border-left: 3px solid var(--hue); border-radius: 12px; }
    .gist-lab { display: block; font-size: 11px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: var(--hue); margin-bottom: 6px; }
    .gist p { margin: 0; font-size: 16px; line-height: 1.55; color: var(--ink); }

    .sec { margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--line-dim); }
    .sec h3 { font-family: var(--display); font-weight: 600; font-size: 19px; color: var(--ink); margin: 0 0 12px; display: flex; align-items: center; gap: 10px; }
    .sec h3 .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--hue); flex: 0 0 auto; }
    .lead { margin: 0 0 11px; font-size: 14px; line-height: 1.55; color: var(--ink-soft); }

    ul.bul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 9px; }
    ul.bul li { position: relative; padding-left: 17px; font-size: 15px; line-height: 1.6; color: var(--ink-soft); }
    ul.bul li::before { content: ''; position: absolute; left: 0; top: 10px; width: 5px; height: 5px; border-radius: 50%; background: var(--line-dim); }
    ul.bul.tick li::before { background: var(--hue); }
    ul.bul li b { color: var(--ink); font-weight: 700; }

    .cues { display: flex; flex-wrap: wrap; gap: 7px; }
    .cues span { font-size: 12.5px; font-weight: 600; color: var(--ink-soft); background: var(--night-2); border: 1px solid var(--line-dim); border-radius: 999px; padding: 5px 12px; }

    .whybox { background: var(--night-2); border: 1px solid var(--line-dim); border-left: 3px solid var(--hue); border-radius: 12px; padding: 13px 15px; font-size: 15px; line-height: 1.55; color: var(--ink); }

    .twocol { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .mini h4 { font-family: var(--body); font-size: 11px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; margin: 0 0 10px; }
    .mini.good h4 { color: #a9d9c6; }
    .mini.bad h4 { color: #e6a9bd; }

    dl.toolkit { margin: 0; display: flex; flex-direction: column; gap: 2px; }
    .tk-row { display: grid; grid-template-columns: minmax(120px, 44%) 1fr; gap: 14px; align-items: start; padding: 10px 0; border-bottom: 1px solid var(--line-soft); }
    .tk-row dt { margin: 0; }
    .tk-row dt code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12.5px; color: #f0dfe7; background: #14101a; border: 1px solid var(--line-dim); border-radius: 7px; padding: 3px 7px; display: inline-block; word-break: break-word; }
    .tk-row dd { margin: 0; font-size: 14px; line-height: 1.5; color: var(--ink-soft); }

    ol.steps { margin: 2px 0 0; padding: 0; list-style: none; counter-reset: step; display: flex; flex-direction: column; gap: 14px; }
    ol.steps li { position: relative; padding-left: 38px; font-size: 14.5px; line-height: 1.6; color: var(--ink-soft); }
    ol.steps li::before { counter-increment: step; content: counter(step); position: absolute; left: 0; top: 0; width: 25px; height: 25px; border-radius: 50%; display: grid; place-items: center; font-family: var(--display); font-weight: 600; font-size: 13px; color: var(--night); background: var(--hue); }
    ol.steps .do { display: block; margin-bottom: 4px; color: var(--ink); font-weight: 700; }

    .keepbox { margin-top: 14px; background: var(--night-2); border: 1px solid var(--line-dim); border-left: 3px solid var(--hue); border-radius: 12px; padding: 12px 15px; font-size: 14.5px; line-height: 1.6; color: var(--ink); }
    .keepbox .klab { font-size: 11px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 5px; }

    .reveal-btn { border: 1px solid var(--line-dim); background: var(--night-2); color: var(--ink); font-family: var(--body); font-weight: 700; font-size: 13px; border-radius: 9px; padding: 9px 13px; cursor: pointer; }
    .reveal-btn:hover { background: var(--panel); }
    pre.code { background: #14101a; border: 1px solid var(--line-dim); border-radius: 11px; padding: 14px 16px; overflow: auto; margin: 12px 0 0; }
    pre.code code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12.5px; line-height: 1.65; color: #ece2ea; white-space: pre; display: block; }

    .qcard { background: var(--night-2); border: 1px solid var(--line-dim); border-radius: 13px; padding: 15px 16px; }
    .qcard p { margin: 0 0 11px; font-size: 15px; line-height: 1.55; color: var(--ink); }
    .qlab { font-size: 11px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-faint); margin: 8px 0 6px; }
    .qskills { display: flex; flex-wrap: wrap; gap: 6px; }
    .qskills span { font-size: 12px; font-weight: 600; color: var(--ink-soft); background: var(--panel); border: 1px solid var(--line-dim); border-radius: 7px; padding: 4px 9px; }
    .qout { font-size: 13.5px; color: var(--ink-soft); font-style: italic; margin-top: 10px; }

    .chiplinks { display: flex; flex-wrap: wrap; gap: 8px; }
    .chiplinks a { display: flex; align-items: center; gap: 8px; text-decoration: none; border: 1px solid var(--line-dim); background: var(--night-2); color: var(--ink); font-weight: 700; font-size: 13.5px; border-radius: 10px; padding: 9px 13px; transition: 0.15s; }
    .chiplinks a:hover { background: var(--panel); transform: translateY(-1px); }
    .chiplinks a .free { font-size: 10px; font-weight: 800; color: #8fc7ad; background: rgba(169, 217, 198, 0.13); border-radius: 5px; padding: 2px 5px; }

    .cxcard { background: var(--night-2); border: 1px solid var(--line-dim); border-radius: 13px; padding: 4px 16px; }
    .cxtable { width: 100%; border-collapse: collapse; font-size: 14px; }
    .cxtable td { padding: 10px 0; border-bottom: 1px solid var(--line-soft); vertical-align: baseline; }
    .cxtable tr:last-child td { border-bottom: 0; }
    .cxop { color: var(--ink-soft); font-weight: 700; white-space: nowrap; padding-right: 12px; }
    .cxval { text-align: right; }
    .cxval b { font-family: var(--display); font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .cxnote { display: block; margin-top: 2px; font-size: 11.5px; font-weight: 600; color: var(--ink-faint); font-style: italic; }
    .cxfoot { margin: 11px 0 6px; font-size: 12px; line-height: 1.5; color: var(--ink-faint); }

    .pager { display: flex; justify-content: space-between; gap: 14px; margin-top: 38px; }
    .pg { flex: 1; display: flex; flex-direction: column; gap: 3px; text-decoration: none; background: var(--night-2); border: 1px solid var(--line-dim); border-radius: 12px; padding: 12px 14px; transition: 0.15s; }
    .pg:hover { background: var(--panel); }
    .pg span { font-size: 12px; color: var(--ink-faint); font-weight: 700; }
    .pg b { font-size: 14px; color: var(--ink); font-weight: 700; }
    .pg.next { text-align: right; }

    .lit-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 50; padding: 14px 18px calc(14px + env(safe-area-inset-bottom)); background: linear-gradient(180deg, rgba(23, 19, 27, 0), rgba(23, 19, 27, 0.92) 42%); display: flex; justify-content: center; pointer-events: none; }
    .lit-bar button { pointer-events: auto; width: min(680px, 100%); border: 0; cursor: pointer; border-radius: 13px; padding: 15px; font-family: var(--display); font-weight: 600; font-size: 16px; color: var(--night); background: var(--hue); box-shadow: 0 10px 26px -10px var(--hue); transition: 0.18s; }
    .lit-bar button:hover { filter: brightness(1.04); transform: translateY(-1px); }
    .lit-bar button.undo { background: var(--night-2); color: var(--ink-soft); box-shadow: none; border: 1px solid var(--line-dim); }
    .lit-bar button:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }

    @media (max-width: 560px) {
      h1 { font-size: 27px; }
      .tk-row { grid-template-columns: 1fr; gap: 5px; }
      .twocol { grid-template-columns: 1fr; }
      .pager { flex-direction: column; }
    }
  </style>
</Base>
